# Generate this automatically with ./docker/setup.sh.
CLI_API_TOKEN=replace-with-a-long-random-token

# URL exposed through your HTTPS reverse proxy.
HAPI_PUBLIC_URL=https://hapi.example.com
CORS_ORIGINS=https://hapi.example.com

# Keep the port loopback-only when a reverse proxy runs on the Docker host.
HAPI_BIND_ADDRESS=127.0.0.1
HAPI_PORT=3006
HAPI_HOSTNAME=vpslab

# "latest" installs each tool only when the persistent tools directory is
# empty. Pin a version here if restarts should enforce that exact version.
CLAUDE_BOOTSTRAP_VERSION=latest
CODEX_BOOTSTRAP_VERSION=latest

HAPI_IMAGE_TAG=latest

